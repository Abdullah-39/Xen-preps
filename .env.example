# Copy to .env and fill in. Everything here is public (it ends up in the browser bundle).
# Never put a secret in a NEXT_PUBLIC_ variable.

# XEN backend (xen-perps-backend). Its CORS only allows http://localhost:3000 in dev.
NEXT_PUBLIC_API_URL=http://localhost:3001

# testnet | mainnet
NEXT_PUBLIC_HL_NETWORK=testnet

# XEN builder wallet. Same value as the backend's BUILDER_ADDRESS. Ask Saif.
NEXT_PUBLIC_BUILDER_ADDRESS=

# Builder fee in tenths of a basis point (50 = 0.05%). Perps max is 100. Ask Saif.
NEXT_PUBLIC_BUILDER_FEE=

# WalletConnect Cloud project ID (RainbowKit). Without it only browser-extension wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
